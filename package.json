{
	"name": "swisseph-api",
	"type": "module",
	"description": "Swiss Ephemeris API for Node.js",
	"author": "Marc Mariné <shenobi@gmail.com>",
	"scripts": {
		"dev": "bun --hot server.tsx",
		"dev:browser": "bun run --filter swisseph-browser dev",
		"dev:all": "bun run --parallel dev dev:browser",
		"build:browser": "bun run --filter swisseph-browser build",
		"start:browser": "bun run build:browser && bun run --filter swisseph-browser start"
	},
	"dependencies": {
		"@swisseph/node": "^1.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/bun": "^1.2.19",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"typescript": "^5.8.3"
	},
	"private": true,
	"workspaces": [
		"browser"
	]
}
